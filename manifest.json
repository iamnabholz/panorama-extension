{
  "{{chrome}}.manifest_version": 3,
  "{{firefox}}.manifest_version": 2,
  "name": "Panorama Tab",
  "version": "3.0.0",
  "description": "Playful new tab page with a glanceable summary of the day, and beautiful backgrounds — simple, private, and fully local.",

  "{{firefox}}.browser_specific_settings": {
    "gecko": {
      "id": "{0e13dd33-a693-4c63-aaed-8061a417426c}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "{{chrome}}.icons": {
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },

  "{{firefox}}.icons": {
    "32": "favicon.svg",
    "64": "favicon.svg",
    "96": "favicon.svg",
    "128": "favicon.svg"
  }
}
