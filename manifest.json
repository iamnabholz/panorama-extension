{
  "{{chrome}}.manifest_version": 3,
  "{{firefox}}.manifest_version": 2,
  "name": "Panorama Tab",
  "version": "2.0.2",
  "description": "New tab replacement with a unique look and style.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "/icons/icon16.png",
    "48": "/icons/icon48.png",
    "96": "/icons/icon96.png",
    "128": "/icons/icon128.png"
  },
  "background": {
    "{{chrome}}.service_worker": "src/background.js",
    "{{firefox}}.scripts": [
      "src/background.js"
    ]
  },
  "permissions": [
    "https://*/",
    "http://*/",
    "topSites"
  ]
}