{
  "{{chrome}}.manifest_version": 3,
  "manifest_version": 2,
  "name": "Panorama Tab",
  "version": "3.0-b",
  "description": "Replace your new tab with a unique look and features.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "/icons/icon16.png",
    "48": "/icons/icon48.png",
    "96": "/icons/icon96.png",
    "128": "/icons/icon128.png"
  },
  "permissions": ["https://*.nabholz.workers.dev/"]
}
